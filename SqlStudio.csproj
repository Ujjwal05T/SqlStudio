<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Address of the company backend baked into this build. Release builds pass -p:CompanyBackendUrl=...; the default is the local API. -->
  <PropertyGroup>
    <CompanyBackendUrl Condition="'$(CompanyBackendUrl)' == ''">http://localhost:5188</CompanyBackendUrl>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="CompanyBackendUrl" Value="$(CompanyBackendUrl)" />
  </ItemGroup>

  <!-- Matches the package condition below: on Windows the developer tools are left out, so Program.cs must not call them. -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <DefineConstants>$(DefineConstants);WINDOWS_NO_DEVTOOLS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
    <!-- The full-size source artwork and the macOS icon file are for packaging, not for embedding in the app -->
    <AvaloniaResource Remove="Assets\Glossy SQL Database Terminal Icon.png" />
    <AvaloniaResource Remove="Assets\AppIcon.icns" />
    <AvaloniaResource Remove="Assets\AppIcon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.5" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.5" />
    <PackageReference Include="AvaloniaEdit.TextMate" Version="12.0.0" />
    <!-- Developer tools (adds a button to the title bar in Debug). Left out on Windows, where that button crowds the window buttons; kept on macOS and Linux. -->
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageReference Include="Microsoft.SqlServer.SqlManagementObjects" Version="181.37.1" />
    <PackageReference Include="Microsoft.SqlServer.TransactSql.ScriptDom" Version="180.140.0" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.14" />
  </ItemGroup>
</Project>
