<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SqlStudio.App"
             xmlns:local="using:SqlStudio"
             RequestedThemeVariant="Default">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <!-- Colours come from ThemeService (one variant per palette). Shape lives here. -->
        <CornerRadius x:Key="ControlCornerRadius">10</CornerRadius>
        <CornerRadius x:Key="OverlayCornerRadius">14</CornerRadius>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />

        <Style Selector="Window">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
        <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource MutedText}" /></Style>
        <Style Selector="TextBlock.caption">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LetterSpacing" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
        </Style>
        <Style Selector="TextBlock.error"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}" /></Style>
        <Style Selector="SelectableTextBlock.error"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}" /></Style>

        <!-- Buttons -->
        <Style Selector="Button"><Setter Property="Padding" Value="14,7" /></Style>
        <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentFill}" />
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
            <Setter Property="TextElement.FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentFillHover}" />
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
        </Style>
        <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Opacity" Value="0.4" />
        </Style>
        <Style Selector="Button.ghost">
            <Setter Property="MinWidth" Value="28" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.ghost /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBg}" />
        </Style>

        <!-- Clickable cards on the home screen -->
        <Style Selector="Button.tile">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="CornerRadius" Value="16" />
        </Style>
        <Style Selector="Button.tile /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.tile:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBg}" />
        </Style>
        <Style Selector="Button.tile:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
        <Style Selector="Border.iconbox">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{DynamicResource PanelBg}" />
        </Style>
        <Style Selector="Border.keycap">
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBg}" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="8,3" />
        </Style>

        <!-- Connection status dot: grey = idle, amber = connecting, green = connected, red = failed -->
        <Style Selector="Ellipse.dot"><Setter Property="Fill" Value="{DynamicResource MutedText}" /></Style>
        <Style Selector="Ellipse.dot.busy"><Setter Property="Fill" Value="{DynamicResource WarnBrush}" /></Style>
        <Style Selector="Ellipse.dot.ok"><Setter Property="Fill" Value="{DynamicResource SuccessBrush}" /></Style>
        <Style Selector="Ellipse.dot.fail"><Setter Property="Fill" Value="{DynamicResource DangerBrush}" /></Style>

        <!-- Environment tags. Fixed fills (white text passes 4.5:1 on all three) so a tag looks the same in every theme. -->
        <Style Selector="Border.env">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.env > TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="LetterSpacing" Value="0.6" />
        </Style>
        <Style Selector="Border.env.dev, Border.strip.dev"><Setter Property="Background" Value="#16794B" /></Style>
        <Style Selector="Border.env.stage, Border.strip.stage"><Setter Property="Background" Value="#9A6700" /></Style>
        <Style Selector="Border.env.prod, Border.strip.prod"><Setter Property="Background" Value="#C62F2F" /></Style>

        <!-- Cards, panels -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource SurfaceBg}" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>
        <Style Selector="Border.floating">
            <Setter Property="Background" Value="{DynamicResource PanelBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
        </Style>
        <Style Selector="CheckBox /template/ Border#NormalRectangle"><Setter Property="CornerRadius" Value="6" /></Style>

        <!-- Tabs as soft pills instead of an underline -->
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="TabItem:selected /template/ Border#PART_LayoutRoot"><Setter Property="Background" Value="{DynamicResource SurfaceHoverBg}" /></Style>
        <!-- Selection, hover and focus use the theme's own colours. Left to Fluent they pick up the macOS system accent
             (a saturated blue that clashes with every scheme here). -->
        <!-- The template binds its corners to the item, so the radius is set on the item itself -->
        <Style Selector="TreeViewItem"><Setter Property="CornerRadius" Value="10" /></Style>
        <Style Selector="TreeViewItem:pointerover /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource SurfaceBg}" />
        </Style>
        <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot, TreeViewItem:selected:pointerover /template/ Border#PART_LayoutRoot, TreeViewItem:selected:focus /template/ Border#PART_LayoutRoot, TreeViewItem:selected:focus:pointerover /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBg}" />
        </Style>
        <Style Selector="TreeViewItem:selected, TreeViewItem:selected:pointerover, TreeViewItem:selected:focus">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
        <Style Selector="MenuItem:pointerover /template/ Border#PART_LayoutRoot, MenuItem:selected /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBg}" />
        </Style>
        <Style Selector="MenuItem"><Setter Property="CornerRadius" Value="8" /></Style>
        <Style Selector="ComboBoxItem">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Margin" Value="0,1" />
        </Style>
        <Style Selector="CheckBox:checked /template/ Border#NormalRectangle, CheckBox:checked:pointerover /template/ Border#NormalRectangle">
            <Setter Property="Background" Value="{DynamicResource AccentFill}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentFill}" />
        </Style>
        <Style Selector="CheckBox:checked /template/ Path#CheckGlyph"><Setter Property="Stroke" Value="{DynamicResource OnAccentBrush}" /></Style>
        <Style Selector="ProgressBar"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /></Style>
        <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle, DataGridRow:selected:pointerover /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill" Value="{DynamicResource SurfaceHoverBg}" />
            <Setter Property="Opacity" Value="1" />
        </Style>

        <!-- Suggestion popup. AvaloniaEdit's completion list ships hard-coded dark grey with white text, so it is
             styled by its part name to follow the theme: rounded, softly selected rows. -->
        <Style Selector=":is(ListBox)#PART_ListBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceBg}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="4" />
        </Style>
        <Style Selector=":is(ListBox)#PART_ListBox ListBoxItem">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
        <!-- Fluent computes its selection brushes from its own built-in accent, which the theme cannot reach, so the
             highlighted row is set directly in every state it can appear in. -->
        <Style Selector=":is(ListBox)#PART_ListBox ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBg}" />
        </Style>
        <Style Selector=":is(ListBox)#PART_ListBox ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, :is(ListBox)#PART_ListBox ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter, :is(ListBox)#PART_ListBox ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter, :is(ListBox)#PART_ListBox ListBoxItem:selected:focus:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBg}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>

        <!-- Results grid -->
        <Style Selector="DataGrid">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="RowHeight" Value="26" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource LineBrush}" />
        </Style>
    </Application.Styles>
</Application>
