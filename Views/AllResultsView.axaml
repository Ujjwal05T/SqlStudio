<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SqlStudio.ViewModels"
             xmlns:v="using:SqlStudio.Views"
             x:Class="SqlStudio.Views.AllResultsView"
             x:DataType="vm:AllResultsViewModel">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Sets}" Margin="0,0,0,12">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ResultSetViewModel">
                    <StackPanel Spacing="6" Margin="0,4,0,14">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" Margin="14,4,14,0" />
                        <Border Height="300">
                            <v:ResultSetView DataContext="{Binding}" />
                        </Border>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</UserControl>
