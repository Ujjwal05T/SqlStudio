<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SqlStudio.ViewModels"
        xmlns:svc="using:SqlStudio.Services"
        xmlns:v="using:SqlStudio.Views"
        x:Class="SqlStudio.Views.CompanySignInWindow"
        x:DataType="vm:CompanySignInViewModel"
        Title="Sign in to Company" Width="420" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="24" Spacing="14">
        <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="4">
                <TextBlock Text="Sign in to Company" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="Use your company email to see the company servers you're allowed to use." />
            </StackPanel>
            <Button Grid.Column="1" Classes="ghost" VerticalAlignment="Top" Margin="12,0,0,0" Click="OnCloseClicked"
                    IsVisible="{x:Static svc:Platform.ShowPopupCloseButton}"
                    AutomationProperties.Name="Close" ToolTip.Tip="Close">
                <v:Icon Kind="close" />
            </Button>
        </Grid>
        <v:CompanySignInView DataContext="{Binding}" />
    </StackPanel>
</Window>
