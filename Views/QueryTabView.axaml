<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SqlStudio.ViewModels"
             xmlns:ae="using:AvaloniaEdit"
             xmlns:v="using:SqlStudio.Views"
             x:Class="SqlStudio.Views.QueryTabView"
             x:DataType="vm:QueryTabViewModel">

    <Grid RowDefinitions="Auto,*,8,*,Auto">
        <!-- Toolbar -->
        <Grid Grid.Row="0">
            <Border Padding="14,10,14,8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="primary" Command="{Binding ExecuteCommand}" AutomationProperties.Name="Run query"
                            ToolTip.Tip="Run (⌘↵ or F5). Runs only the selected text if there is a selection.">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <v:Icon Kind="play" Width="13" Height="13" VerticalAlignment="Center" />
                            <TextBlock Text="Run" />
                            <TextBlock Text="⌘↵" Opacity="0.8" FontSize="11" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding CancelCommand}" AutomationProperties.Name="Stop query" ToolTip.Tip="Stop the running query (⌘.)">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <v:Icon Kind="stop" Width="13" Height="13" VerticalAlignment="Center" />
                            <TextBlock Text="Stop" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SnippetsButton" AutomationProperties.Name="Insert a snippet"
                            ToolTip.Tip="Insert a common DBA query at the cursor">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <v:Icon Kind="sparkles" Width="14" Height="14" VerticalAlignment="Center" Stroke="{DynamicResource AccentBrush}" />
                            <TextBlock Text="Snippets" />
                        </StackPanel>
                    </Button>
                    <Border Width="1" Margin="4,4" Background="{DynamicResource LineBrush}" />
                    <TextBlock Text="Database" Classes="muted" VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{Binding Databases}" SelectedItem="{Binding SelectedDatabase}"
                              MinWidth="200" MaxDropDownHeight="400" AutomationProperties.Name="Database for this query"
                              PlaceholderText="Choose a database" />
                    <Border Classes="env" Classes.dev="{Binding IsDev}" Classes.stage="{Binding IsStaging}"
                            Classes.prod="{Binding IsProd}" IsVisible="{Binding HasEnv}">
                        <TextBlock Text="{Binding EnvLabel}" />
                    </Border>
                </StackPanel>
            </Border>
            <!-- Colour strip across the top of the tab: red for production, amber for staging, green for development -->
            <Border Classes="strip" Classes.dev="{Binding IsDev}" Classes.stage="{Binding IsStaging}"
                    Classes.prod="{Binding IsProd}" Height="3" VerticalAlignment="Top" IsVisible="{Binding HasEnv}" />
            <!-- Thin activity line while connecting or running -->
            <ProgressBar IsIndeterminate="True" Height="2" MinHeight="2" VerticalAlignment="Bottom"
                         IsVisible="{Binding IsBusy}" AutomationProperties.Name="Working" />
        </Grid>

        <!-- Editor card -->
        <Border Grid.Row="1" Margin="12,0,12,0" CornerRadius="14" ClipToBounds="True" Background="{DynamicResource SurfaceBg}">
            <Grid>
                <ae:TextEditor x:Name="Editor" Margin="4,8,0,0" ShowLineNumbers="True"
                               FontFamily="Menlo, Monaco, Consolas, monospace" FontSize="13"
                               AutomationProperties.Name="SQL editor"
                               HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
                <!-- Hint shown only while the editor is empty -->
                <StackPanel x:Name="EmptyHint" Margin="78,10,24,0" Spacing="6" VerticalAlignment="Top" HorizontalAlignment="Left"
                            IsHitTestVisible="False">
                    <TextBlock Text="Write SQL here, then press ⌘↵ to run it." Classes="muted" FontSize="14" />
                    <TextBlock Text="Table and column suggestions appear as you type (Ctrl+Space asks for them). Snippets has sizes, blocking, slow queries, backup history and more."
                               Classes="muted" FontSize="12" Opacity="0.8" TextWrapping="Wrap" MaxWidth="460" />
                </StackPanel>
            </Grid>
        </Border>

        <GridSplitter Grid.Row="2" Background="Transparent" ResizeDirection="Rows" />

        <!-- Results / messages card -->
        <Border Grid.Row="3" Margin="12,0,12,0" CornerRadius="14" ClipToBounds="True" Background="{DynamicResource SurfaceBg}">
            <TabControl ItemsSource="{Binding Panels}" SelectedItem="{Binding SelectedPanel}" Padding="0,4,0,0">
                <TabControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ResultPanelViewModel">
                        <TextBlock Text="{Binding Title}" />
                    </DataTemplate>
                </TabControl.ItemTemplate>
            </TabControl>
        </Border>

        <!-- Status bar: connection on the left, last run on the right -->
        <Border Grid.Row="4" Padding="18,9,18,10">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Ellipse Classes="dot" Classes.busy="{Binding IsConnecting}" Classes.ok="{Binding IsConnected}"
                             Classes.fail="{Binding IsFailed}" Width="8" Height="8" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ConnectionText}" Classes="muted" FontSize="12" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding ResultSummary}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
