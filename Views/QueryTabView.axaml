<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SqlStudio.ViewModels"
             xmlns:ae="using:AvaloniaEdit"
             xmlns:v="using:SqlStudio.Views"
             xmlns:svc="using:SqlStudio.Services"
             x:Class="SqlStudio.Views.QueryTabView"
             x:DataType="vm:QueryTabViewModel">

    <Grid RowDefinitions="Auto,*,8,*,Auto">
        <!-- Toolbar -->
        <Grid Grid.Row="0">
            <Border Padding="14,10,14,8">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="primary" Command="{Binding ExecuteCommand}" AutomationProperties.Name="Run query"
                                ToolTip.Tip="{x:Static svc:Shortcuts.RunTipText}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <v:Icon Kind="play" Width="13" Height="13" VerticalAlignment="Center" />
                                <TextBlock Text="Run" />
                                <TextBlock Text="{x:Static svc:Shortcuts.RunText}" Opacity="0.8" FontSize="11" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="ghost" Command="{Binding CancelCommand}" Padding="12,7" AutomationProperties.Name="Stop query" ToolTip.Tip="{x:Static svc:Shortcuts.StopTipText}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <v:Icon Kind="stop" Width="13" Height="13" VerticalAlignment="Center" />
                                <TextBlock Text="Stop" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="PlanButton" Classes="ghost" Padding="12,7" AutomationProperties.Name="Execution plan"
                                ToolTip.Tip="See how SQL Server runs this query, and which steps cost the most">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <v:Icon Kind="plan" Width="14" Height="14" VerticalAlignment="Center" Stroke="{DynamicResource AccentBrush}" />
                                <TextBlock Text="Explain Plan" />
                                <v:Icon Kind="chevron-down" Width="12" Height="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="SnippetsButton" Classes="ghost" Padding="12,7" AutomationProperties.Name="Insert a snippet"
                                ToolTip.Tip="Insert a common DBA query at the cursor">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <v:Icon Kind="sparkles" Width="14" Height="14" VerticalAlignment="Center" Stroke="{DynamicResource AccentBrush}" />
                                <TextBlock Text="Snippets" />
                                <v:Icon Kind="chevron-down" Width="12" Height="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <v:Icon Kind="database" Width="15" Height="15" Stroke="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                        <ComboBox ItemsSource="{Binding Databases}" SelectedItem="{Binding SelectedDatabase}"
                                  MinWidth="200" MaxDropDownHeight="400" AutomationProperties.Name="Database for this query"
                                  PlaceholderText="Choose a database" />
                        <Border Classes="env" Classes.dev="{Binding IsDev}" Classes.stage="{Binding IsStaging}"
                                Classes.prod="{Binding IsProd}" IsVisible="{Binding HasEnv}">
                            <TextBlock Text="{Binding EnvLabel}" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
            <!-- Colour strip across the top of the tab: red for production, amber for staging, green for development -->
            <Border Classes="strip" Classes.dev="{Binding IsDev}" Classes.stage="{Binding IsStaging}"
                    Classes.prod="{Binding IsProd}" Height="3" VerticalAlignment="Top" IsVisible="{Binding HasEnv}" />
            <!-- Thin activity line while connecting or running -->
            <ProgressBar IsIndeterminate="True" Height="2" MinHeight="2" VerticalAlignment="Bottom"
                         IsVisible="{Binding IsBusy}" AutomationProperties.Name="Working" />
        </Grid>

        <!-- Editor card -->
        <Border Grid.Row="1" Margin="12,0,12,0" CornerRadius="14" ClipToBounds="True" Background="{DynamicResource SurfaceBg}">
            <Grid>
                <ae:TextEditor x:Name="Editor" Margin="4,8,0,0" ShowLineNumbers="True"
                               FontFamily="Menlo, Monaco, Consolas, monospace" FontSize="13"
                               AutomationProperties.Name="SQL editor"
                               HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
                <!-- Hint shown only while the editor is empty -->
                <!-- Margin matches where the editor's own text starts (pinned by a test), so the hint sits exactly where typing will -->
                <StackPanel x:Name="EmptyHint" Margin="56,8,24,0" Spacing="6" VerticalAlignment="Top" HorizontalAlignment="Left"
                            IsHitTestVisible="False">
                    <TextBlock Text="{x:Static svc:Shortcuts.EmptyEditorHintText}" Classes="muted" FontSize="14" />
                    <TextBlock Text="Table and column suggestions appear as you type (Ctrl+Space asks for them). Snippets has sizes, blocking, slow queries, backup history and more."
                               Classes="muted" FontSize="12" Opacity="0.8" TextWrapping="Wrap" MaxWidth="460" />
                </StackPanel>
            </Grid>
        </Border>

        <GridSplitter x:Name="ResultsSplitter" Grid.Row="2" Background="Transparent" ResizeDirection="Rows" />

        <!-- Results / messages card -->
        <Border x:Name="ResultsCard" Grid.Row="3" Margin="12,0,12,0" CornerRadius="14" ClipToBounds="True" Background="{DynamicResource SurfaceBg}">
            <Grid>
            <TabControl Classes="panels" ItemsSource="{Binding Panels}" SelectedItem="{Binding SelectedPanel}" Padding="0,6,0,0">
                    <TabControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ResultPanelViewModel">
                            <TextBlock Text="{Binding Title}" />
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                </TabControl>
                <Button Classes="ghost" Command="{Binding CloseResultsCommand}" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,6,8,0" Padding="6" AutomationProperties.Name="Close results" ToolTip.Tip="Hide the results and give the editor the full height">
                    <v:Icon Kind="close" Width="13" Height="13" />
                </Button>
            </Grid>
        </Border>

        <!-- Status bar: the last run on the left; cursor position, language and connection on the right -->
        <Border Grid.Row="4" Padding="18,9,18,10">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Ellipse Classes="spinner" VerticalAlignment="Center" IsVisible="{Binding IsExecuting}" />
                    <TextBlock Text="{Binding ResultSummary}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16">
                    <TextBlock x:Name="CaretText" Text="Ln 1, Col 1" Classes="muted" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Text="T-SQL" Classes="muted" FontSize="12" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse Classes="dot" Classes.ok="{Binding IsConnected}" Classes.fail="{Binding IsFailed}"
                                 Width="8" Height="8" VerticalAlignment="Center" IsVisible="{Binding !IsConnecting}" />
                        <Ellipse Classes="spinner" VerticalAlignment="Center" IsVisible="{Binding IsConnecting}" />
                        <TextBlock Text="{Binding ConnectionText}" Classes="muted" FontSize="12" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" MaxWidth="320" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
