<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SqlStudio.ViewModels"
        xmlns:svc="using:SqlStudio.Services"
        xmlns:v="using:SqlStudio.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="760"
        x:Class="SqlStudio.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="SqlStudio"
        Width="1320" Height="820" MinWidth="900" MinHeight="560"
        Background="{DynamicResource AppBg}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="40">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Resources>
        <!-- One row template for both the Company and My servers trees. -->
                    
                        <TreeDataTemplate x:Key="NodeTemplate" x:DataType="vm:ExplorerNode" ItemsSource="{Binding Children}">
                            <!-- Icon, name, host, then a right-hand cluster that always stays visible. The name is capped so a long
                                 server name can never push the environment tag (the PROD warning) out of view. -->
                            <Panel>
                            <Grid ColumnDefinitions="Auto,Auto,*,Auto" Background="Transparent" Margin="0,3" IsVisible="{Binding !IsSkeleton}">
                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="New query" IsVisible="{Binding CanNewQuery}" Click="OnNodeNewQuery" />
                                        <MenuItem Header="Select top 1000 rows" IsVisible="{Binding IsTableOrView}" Click="OnNodeSelectTop" />
                                        <MenuItem Header="Back up database…" IsVisible="{Binding CanBackup}" Click="OnNodeBackup" />
                                        <MenuItem Header="Restore database…" IsVisible="{Binding CanRestore}" Click="OnNodeRestore" />
                                        <MenuItem Header="Show ER diagram…" IsVisible="{Binding CanDiagram}" Click="OnNodeDiagram" />
                                        <MenuItem Header="Notes for Claude…" IsVisible="{Binding CanNote}" Click="OnNodeNote" />
                                        <MenuItem Header="Compare schema…" IsVisible="{Binding CanCompare}" Click="OnNodeCompare" />
                                        <MenuItem Header="Refresh" IsVisible="{Binding CanRefresh}" Click="OnNodeRefresh" />
                                        <MenuItem Header="Disconnect" IsVisible="{Binding CanDisconnect}" Click="OnNodeDisconnect" />
                                        <Separator IsVisible="{Binding CanEditServer}" />
                                        <MenuItem Header="Edit server…" IsVisible="{Binding CanEditServer}" Click="OnNodeEdit" />
                                        <MenuItem Header="Delete server…" IsVisible="{Binding CanEditServer}" Click="OnNodeDelete" />
                                    </ContextMenu>
                                </Grid.ContextMenu>
                                <v:Icon Kind="{Binding IconKind}" Opacity="{Binding IconOpacity}" VerticalAlignment="Center" Margin="0,0,8,0"
                                        Stroke="{DynamicResource AccentBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" Classes.error="{Binding IsError}"
                                           MaxWidth="140" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
                                <TextBlock Grid.Column="2" Text="{Binding Detail}" Classes="muted" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"
                                           TextTrimming="CharacterEllipsis" />
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" Margin="8,0,4,0" VerticalAlignment="Center">
                                    <Ellipse Classes="dot ok" Width="8" Height="8" IsVisible="{Binding IsConnected}"
                                             ToolTip.Tip="Connected. Right-click the server to disconnect." />
                                    <v:Icon Kind="note" Width="13" Height="13" Stroke="{DynamicResource MutedText}" IsVisible="{Binding HasNote}"
                                            ToolTip.Tip="Has a note for Claude" />
                                    <Border Classes="env" Classes.dev="{Binding IsDev}" Classes.stage="{Binding IsStaging}"
                                            Classes.prod="{Binding IsProd}" IsVisible="{Binding HasEnv}">
                                        <TextBlock Text="{Binding EnvShort}" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                                <!-- Shown while the children load: pulsing grey bars, not the words "Loading…". They start exactly under the parent's name
                                     (a child row is indented, so the margin pulls the bar back to that line; pinned by a test). -->
                                <Border Classes="skeleton" IsVisible="{Binding IsSkeleton}" Width="{Binding SkeletonWidth}"
                                        HorizontalAlignment="Left" Margin="8,9,0,9" />
                            </Panel>
                        </TreeDataTemplate>
                    
    </Window.Resources>

    <!-- Shortcuts (new query, close tab) are handled in MainWindow.axaml.cs with the platform's command key: ⌘ on a Mac, Ctrl elsewhere. -->

    <!-- Row 0 is the title strip: the system draws its window buttons here (left on a Mac, right on Windows), clear of the rounded panels below -->
    <Grid x:Name="RootGrid" RowDefinitions="40,*">
        <Border x:Name="DragStrip" Background="Transparent" />
        <!-- On top of the drag strip: logo and name, the server/database of the open tab, and the theme button.
             The margin comes from Platform.TitleBar, so our content stays clear of wherever this system puts its window buttons. -->
        <Grid Margin="{x:Static svc:Platform.TitleBar}" ColumnDefinitions="Auto,*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center" IsHitTestVisible="False"
                        IsVisible="{x:Static svc:Platform.ShowOwnTitleBrand}">
                <Border Width="22" Height="22" CornerRadius="6" ClipToBounds="True">
                    <Image Source="/Assets/AppIcon.png" Stretch="UniformToFill" />
                </Border>
                <TextBlock Text="SqlStudio" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                        IsHitTestVisible="False" IsVisible="{Binding !HasNoTabs}">
                <Border Classes="chip">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse Classes="dot" Classes.ok="{Binding SelectedTab.IsConnected}" Classes.fail="{Binding SelectedTab.IsFailed}"
                                 Width="8" Height="8" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SelectedTab.ServerName}" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Border Classes="chip" IsVisible="{Binding SelectedTab.SelectedDatabase, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <v:Icon Kind="database" Width="14" Height="14" Stroke="{DynamicResource AccentBrush}" />
                        <TextBlock Text="{Binding SelectedTab.SelectedDatabase}" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>
                    <Button Grid.Column="2" Classes="ghost" VerticalAlignment="Center"
                            AutomationProperties.Name="Change theme" ToolTip.Tip="Change theme">
                        <v:Icon Kind="sun" />
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <StackPanel Width="270" Spacing="2">
                                    <TextBlock Classes="caption" Text="THEME" Margin="10,2,10,8" />
                                    <ScrollViewer MaxHeight="420" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding Themes}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ThemeChoice">
                                                <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                        Padding="8,7" Command="{Binding SelectCommand}">
                                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                                        <!-- Mini preview of the scheme: window, panel, card, accent, text -->
                                                        <Border Width="52" Height="30" CornerRadius="9" Background="{Binding AppBrush}" Padding="4">
                                                            <Border CornerRadius="6" Background="{Binding PanelBrush}" Padding="4,0" ClipToBounds="True">
                                                                <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                                                    <Ellipse Width="8" Height="8" Fill="{Binding AccentSwatch}" />
                                                                    <Border Width="9" Height="8" CornerRadius="3" Background="{Binding SurfaceBrush}" />
                                                                    <Border Width="9" Height="4" CornerRadius="2" Background="{Binding TextSwatch}" />
                                                                </StackPanel>
                                                            </Border>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding Kind}" Classes="muted" FontSize="11" />
                                                        </StackPanel>
                                                        <v:Icon Grid.Column="2" Kind="check" VerticalAlignment="Center"
                                                                Stroke="{DynamicResource AccentBrush}" IsVisible="{Binding IsSelected}" />
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
        </Grid>

        <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290" MinWidth="220" MaxWidth="520" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Server sidebar: a floating rounded panel -->
        <Border Classes="floating" Margin="8,4,0,8">
            <DockPanel Margin="0,16,0,14">
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto,Auto,Auto" Margin="20,0,10,8">
                    <TextBlock Text="Object Explorer" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="ghost" Click="OnRefreshSelected"
                            IsEnabled="{Binding SelectedNode.CanRefresh, FallbackValue=False}"
                            AutomationProperties.Name="Refresh" ToolTip.Tip="Refresh the selected item">
                        <v:Icon Kind="refresh" />
                    </Button>
                    <Button Grid.Column="2" Classes="ghost" Click="OnConnectClaude"
                            AutomationProperties.Name="{Binding ClaudeStatusText}" ToolTip.Tip="{Binding ClaudeStatusText}">
                        <Grid>
                            <v:Icon Kind="sparkles" />
                            <!-- green dot = the Claude server is listening -->
                            <Ellipse Classes="dot ok" Width="7" Height="7" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                     Margin="0,0,-3,-3" IsVisible="{Binding ClaudeIsOn}" />
                        </Grid>
                    </Button>
                    <Button Grid.Column="3" Classes="ghost" Click="OnCompanySignIn" IsVisible="{Binding ShowCompanySignInCard}"
                            AutomationProperties.Name="Sign in to Company" ToolTip.Tip="Sign in to Company">
                        <v:Icon Kind="lock" />
                    </Button>
                    <Button Grid.Column="4" Classes="ghost" Click="OnAddConnection"
                            AutomationProperties.Name="Add server" ToolTip.Tip="Add a server">
                        <v:Icon Kind="plus" />
                    </Button>
                </Grid>

                <TextBox DockPanel.Dock="Top" Text="{Binding FilterText}" Margin="14,0,14,8"
                         PlaceholderText="Filter servers and databases" IsVisible="{Binding !HasNoServers}"
                         AutomationProperties.Name="Filter servers and databases"
                         ToolTip.Tip="Searches servers and the databases already loaded. Expand a server to include its databases." />
                <TextBlock DockPanel.Dock="Top" Classes="muted" Margin="20,4,14,0" Text="No matches. Expand a server to search its databases."
                           TextWrapping="Wrap" IsVisible="{Binding HasNoMatches}" />

                <!-- Credit line; declared first so it docks lowest, under the tools -->
                <StackPanel DockPanel.Dock="Bottom" Margin="10,14,10,0">
                    <Border Height="1" Background="{DynamicResource LineBrush}" Margin="6,0,6,8" />
                    <TextBlock Classes="muted" FontSize="11" HorizontalAlignment="Center" Text="Designed &amp; built by Ujjwal" />
                </StackPanel>

                <!-- Tools that act on the server or database selected in the tree -->
                <StackPanel DockPanel.Dock="Bottom" Margin="10,8,10,0" Spacing="1">
                    <Border Height="1" Background="{DynamicResource LineBrush}" Margin="6,0,6,6" />
                    <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,7" Click="OnNodeDiagram" IsEnabled="{Binding SelectedNode.CanDiagram, FallbackValue=False}" ToolTip.Tip="Draw the selected database as an ER diagram">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <v:Icon Kind="diagram" Stroke="{DynamicResource AccentBrush}" />
                            <TextBlock Text="ER Diagram" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,7" Click="OnNodeDependencies" IsEnabled="{Binding SelectedNode.CanDependencies, FallbackValue=False}" ToolTip.Tip="Show what the selected object depends on">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <v:Icon Kind="plan" Stroke="{DynamicResource AccentBrush}" />
                            <TextBlock Text="Dependencies" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,7" Click="OnNodeCompare" IsEnabled="{Binding SelectedNode.CanCompare, FallbackValue=False}" ToolTip.Tip="Compare the selected database with another">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <v:Icon Kind="swap" Stroke="{DynamicResource AccentBrush}" />
                            <TextBlock Text="Schema Compare" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,7" x:Name="BackupRestoreButton" ToolTip.Tip="Back up or restore the selected database">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <v:Icon Kind="restore" Stroke="{DynamicResource AccentBrush}" />
                            <TextBlock Text="Backup &amp; Restore" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- First-run empty state -->
                <StackPanel IsVisible="{Binding HasNoServers}" Margin="24,32,24,0" Spacing="10">
                    <TextBlock Text="No servers yet" FontWeight="SemiBold" FontSize="15" />
                    <TextBlock Classes="muted" TextWrapping="Wrap"
                               Text="Add a SQL Server to browse its databases, run queries, and back up or restore." />
                    <Button Classes="primary" Content="Add a server" HorizontalAlignment="Left" Margin="0,6,0,0" Click="OnAddConnection" />
                </StackPanel>

                <!-- Company section: locked servers from the company account. Hidden until the user signs in. -->
                <StackPanel DockPanel.Dock="Top" IsVisible="{Binding ShowCompanySection}" Margin="0,0,0,8">
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="20,0,10,4">
                        <v:Icon Kind="lock" Stroke="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Company" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding CompanyStatusText}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap" ToolTip.Tip="{Binding CompanyStatusText}" />
                        </StackPanel>
                        <Button Grid.Column="2" Classes="ghost" AutomationProperties.Name="Company menu" ToolTip.Tip="Company options">
                            <TextBlock Text="•••" />
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuItem Header="Sign out of Company" Click="OnCompanySignOut" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                    <TextBlock Classes="muted" Margin="20,4,14,4" TextWrapping="Wrap" Text="No company connections are assigned to you."
                               IsVisible="{Binding HasNoCompanyServers}" />
                    <TreeView ItemsSource="{Binding CompanyServers}" SelectedItem="{Binding SelectedCompanyNode}" ItemTemplate="{StaticResource NodeTemplate}"
                              IsVisible="{Binding !HasNoCompanyServers}" AutomationProperties.Name="Company servers"
                              Background="Transparent" Margin="6,0" MaxHeight="260" DoubleTapped="OnNodeDoubleTapped">
                        <TreeView.Styles>
                            <Style Selector="TreeViewItem" x:DataType="vm:ExplorerNode">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="IsVisible" Value="{Binding IsFilterVisible}" />
                                <Setter Property="IsHitTestVisible" Value="{Binding !IsSkeleton}" />
                            </Style>
                        </TreeView.Styles>
                    </TreeView>
                    <TextBlock Text="My servers" FontWeight="SemiBold" Margin="20,12,0,0" />
                </StackPanel>

                <TreeView ItemsSource="{Binding Servers}" SelectedItem="{Binding SelectedUserNode}" ItemTemplate="{StaticResource NodeTemplate}"
                          IsVisible="{Binding !HasNoServers}" AutomationProperties.Name="Servers and databases"
                          Background="Transparent" Margin="6,0" DoubleTapped="OnNodeDoubleTapped">
                    <TreeView.Styles>
                        <Style Selector="TreeViewItem" x:DataType="vm:ExplorerNode">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="IsVisible" Value="{Binding IsFilterVisible}" />
                            <Setter Property="IsHitTestVisible" Value="{Binding !IsSkeleton}" />
                        </Style>
                    </TreeView.Styles>
                </TreeView>
            </DockPanel>
        </Border>

        <GridSplitter Grid.Column="1" Background="Transparent" ResizeDirection="Columns" />

        <!-- Workspace: a second floating panel -->
        <Border Grid.Column="2" Classes="floating" Margin="0,4,8,8" ClipToBounds="True">
            <Grid RowDefinitions="8,*">

                <TabControl Grid.Row="1" Classes="workspace" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}"
                            IsVisible="{Binding !HasNoTabs}" Padding="0">
                    <TabControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:QueryTabViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse Classes="dot" Classes.busy="{Binding IsConnecting}" Classes.ok="{Binding IsConnected}"
                                         Classes.fail="{Binding IsFailed}" Width="7" Height="7" VerticalAlignment="Center" />
                                <v:Icon Kind="sparkles" Width="13" Height="13" Stroke="{DynamicResource AccentBrush}" VerticalAlignment="Center"
                                        IsVisible="{Binding FromClaude}" ToolTip.Tip="Opened by Claude" />
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                                <Border Classes="env" Classes.dev="{Binding IsDev}" Classes.stage="{Binding IsStaging}"
                                        Classes.prod="{Binding IsProd}" IsVisible="{Binding HasEnv}">
                                    <TextBlock Text="{Binding EnvShort}" />
                                </Border>
                                <Button Classes="ghost" MinWidth="24" MinHeight="24" Padding="0"
                                        Command="{Binding CloseCommand}" AutomationProperties.Name="Close query tab"
                                        ToolTip.Tip="{x:Static svc:Shortcuts.CloseTabTipText}">
                                    <v:Icon Kind="close" Width="12" Height="12" />
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                </TabControl>

                <Button Grid.Row="1" Classes="ghost" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,10,0"
                        Command="{Binding NewQueryCommand}" IsVisible="{Binding !HasNoTabs}"
                        AutomationProperties.Name="New query" ToolTip.Tip="{x:Static svc:Shortcuts.NewQueryTipText}">
                    <v:Icon Kind="plus" />
                </Button>

                <!-- Home: shown whenever no query is open -->
                <ScrollViewer Grid.Row="1" IsVisible="{Binding HasNoTabs}" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="940" Margin="36,6,36,40" Spacing="30">

                        <StackPanel Orientation="Horizontal" Spacing="18">
                            <StackPanel Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="SqlStudio" FontSize="32" FontWeight="Bold" />
                                <TextBlock Classes="muted" FontSize="14" TextWrapping="Wrap"
                                           Text="{x:Static svc:Platform.TaglineText}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Quick actions -->
                        <Grid ColumnDefinitions="1.5*,*,*,*">
                            <Button Grid.Column="0" Classes="tile hero" Margin="0,0,6,0" Command="{Binding NewQueryCommand}"
                                    ToolTip.Tip="{x:Static svc:Shortcuts.OpenQueryTipText}">
                                <StackPanel Spacing="12">
                                    <Border Classes="iconbox"><v:Icon Kind="play" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{DynamicResource AccentBrush}" /></Border>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="New query" FontWeight="SemiBold" />
                                        <TextBlock Text="On the selected server" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" Classes="tile" Margin="6,0" Click="OnAddConnection">
                                <StackPanel Spacing="12">
                                    <Border Classes="iconbox"><v:Icon Kind="plus" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{DynamicResource AccentBrush}" /></Border>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Add a server" FontWeight="SemiBold" />
                                        <TextBlock Text="SQL login or Entra ID" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Classes="tile" Margin="6,0" Click="OnOpenSqlFile">
                                <StackPanel Spacing="12">
                                    <Border Classes="iconbox"><v:Icon Kind="file" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{DynamicResource AccentBrush}" /></Border>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Open SQL file" FontWeight="SemiBold" />
                                        <TextBlock Text="Load a .sql script" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="3" Classes="tile" Margin="6,0,0,0" Click="OnHomeRestore">
                                <StackPanel Spacing="12">
                                    <Border Classes="iconbox"><v:Icon Kind="restore" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{DynamicResource AccentBrush}" /></Border>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Restore a database" FontWeight="SemiBold" />
                                        <TextBlock Text="From a backup on the server" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Recent queries -->
                        <StackPanel Spacing="10">
                            <TextBlock Classes="caption" Text="RECENT QUERIES" />
                            <Border Classes="card" Padding="22" IsVisible="{Binding HasNoRecent}">
                                <TextBlock Classes="muted" TextWrapping="Wrap"
                                           Text="Queries you run show up here, so you can open them again with one click." />
                            </Border>
                            <ItemsControl ItemsSource="{Binding RecentQueries}" IsVisible="{Binding HasRecent}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="svc:HistoryEntry">
                                        <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                Padding="12,9" Click="OnRecentClick" ToolTip.Tip="Open this query again">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <Ellipse Classes="dot" Classes.ok="{Binding Ok}" Classes.fail="{Binding !Ok}"
                                                         Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,12,0" />
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBlock Text="{Binding Preview}" FontFamily="Menlo, Monaco, Consolas, monospace" FontSize="12"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Where}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding When}" Classes="muted" FontSize="12"
                                                           VerticalAlignment="Center" Margin="12,0,0,0" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Servers -->
                        <StackPanel Spacing="12">
                            <TextBlock Classes="caption" Text="YOUR SERVERS" />
                            <Border Classes="card" Padding="22" IsVisible="{Binding HasNoServers}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Connect your first server" FontWeight="SemiBold" FontSize="15" />
                                    <TextBlock Classes="muted" TextWrapping="Wrap"
                                               Text="{x:Static svc:Platform.AddServerHintText}" />
                                    <Button Classes="primary" Content="Add a server" HorizontalAlignment="Left" Margin="0,6,0,0" Click="OnAddConnection" />
                                </StackPanel>
                            </Border>
                            <ItemsControl ItemsSource="{Binding Servers}" IsVisible="{Binding !HasNoServers}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ExplorerNode">
                                        <Button Classes="tile" Width="286" Margin="0,0,12,12" Click="OnServerCard" ToolTip.Tip="Open a query on this server">
                                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                                                <Border Classes="iconbox" Grid.RowSpan="2" Margin="0,0,12,0" VerticalAlignment="Center">
                                                    <v:Icon Kind="server" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{DynamicResource AccentBrush}" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="150" />
                                                    <Border Classes="env" Classes.dev="{Binding IsDev}" Classes.stage="{Binding IsStaging}"
                                                            Classes.prod="{Binding IsProd}" IsVisible="{Binding HasEnv}">
                                                        <TextBlock Text="{Binding EnvShort}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding Detail}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Shortcuts -->
                        <Border Classes="card" Padding="20,16">
                            <StackPanel Spacing="12">
                                <TextBlock Classes="caption" Text="SHORTCUTS" />
                                <WrapPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,26,8">
                                        <Border Classes="keycap"><TextBlock Text="{x:Static svc:Shortcuts.NewQueryText}" FontFamily="Menlo, Monaco, Consolas, monospace" FontSize="12" /></Border>
                                        <TextBlock Text="New query" Classes="muted" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,26,8">
                                        <Border Classes="keycap"><TextBlock Text="{x:Static svc:Shortcuts.RunText}" FontFamily="Menlo, Monaco, Consolas, monospace" FontSize="12" /></Border>
                                        <TextBlock Text="Run (or just the selection)" Classes="muted" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,26,8">
                                        <Border Classes="keycap"><TextBlock Text="{x:Static svc:Shortcuts.StopText}" FontFamily="Menlo, Monaco, Consolas, monospace" FontSize="12" /></Border>
                                        <TextBlock Text="Stop" Classes="muted" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,26,8">
                                        <Border Classes="keycap"><TextBlock Text="{x:Static svc:Shortcuts.CloseTabText}" FontFamily="Menlo, Monaco, Consolas, monospace" FontSize="12" /></Border>
                                        <TextBlock Text="Close tab" Classes="muted" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,26,8">
                                        <Border Classes="keycap"><TextBlock Text="GO" FontFamily="Menlo, Monaco, Consolas, monospace" FontSize="12" /></Border>
                                        <TextBlock Text="Splits batches, just like SSMS" Classes="muted" VerticalAlignment="Center" />
                                    </StackPanel>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
        </Grid>
    </Grid>
</Window>
